{
  "name": "evo-subagent",
  "version": "1.1.0",
  "description": "Adaptive styles and independent workspace personas for DeepSeek Harness, with conversation profiles, role routing and optional Bilibili content learning",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./binding": "./binding.js",
    "./habits": "./habits.js",
    "./persona": "./persona.js",
    "./client": "./dsh/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "plugin.js",
    "binding.js",
    "habits.js",
    "habits-store.js",
    "persona.js",
    "persona-store.js",
    "preferences.js",
    "sharing.js",
    "bili-bridge.js",
    "evolution.js",
    "scope.js",
    "skills.js",
    "skills",
    "cordis.patch.yml",
    "templates",
    "dsh",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none",
    "check": "node --check index.js && node --check plugin.js && node --check binding.js && node --check evolution.js && node --check scope.js && node --check skills.js && node --check habits.js && node --check habits-store.js && node --check persona.js && node --check persona-store.js && node --check preferences.js && node --check sharing.js && node --check bili-bridge.js && node --check dsh/client.js",
    "prepack": "npm run check && npm test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "subagent",
    "model-routing",
    "persona",
    "user-preferences"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZekaiShi/evo-subagent.git"
  },
  "homepage": "https://github.com/ZekaiShi/evo-subagent#readme",
  "bugs": {
    "url": "https://github.com/ZekaiShi/evo-subagent/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": "^0.2.1-rc.2",
    "node": ">=24.2.0"
  },
  "packageManager": "pnpm@11.19.0",
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
